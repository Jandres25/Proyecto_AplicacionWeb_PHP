{
  "name": "proyecto/aplicacion-web-php",
  "description": "Gestión de Flota - PHP custom N-Layer",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.7"
  },
  "require-dev": {
    "symfony/var-dumper": "^7.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Core\\": "core/"
    },
    "files": ["core/helpers.php"]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
